# ---------------------------------------------------------------------------
# SC Sourcing Engine — environment variables
# Copy this file to `.env` and fill in values as needed.
# The app runs fully locally with mock providers if no API keys are present.
# ---------------------------------------------------------------------------

# PostgreSQL connection (Neon free tier: neon.tech). DATABASE_URL is the pooled
# string; DIRECT_URL the unpooled one (remove "-pooler") used for schema pushes.
# Using the same URL for both also works.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# ---- LLM (email generation) ----
# LLM_PROVIDER: "mock" (default, no key needed) | "openai" | "anthropic"
LLM_PROVIDER="mock"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
# Optional model overrides
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_MODEL="claude-sonnet-4-6"

# ---- Lead sourcing providers ----
# Leave blank to use the local mock providers.
APOLLO_API_KEY=""
CLAY_API_KEY=""
CLAY_WORKFLOW_URL=""

# ---- Email finding / verification ----
# Hunter.io (free tier available). Used to find + verify emails during
# enrichment. Leave blank to fall back to pattern-guessed (unverified) emails.
HUNTER_API_KEY=""

# ---- SAM.gov (federal registrants connector) ----
# Free key at https://sam.gov/content/api-keys . Optional.
SAM_API_KEY=""

# ---- Auth ----
# "true" (default) lets anyone create an Admin account at /signup. Set to
# "false" after onboarding to make new accounts invite-only.
OPEN_SIGNUP="true"

# ---- Scheduled follow-ups ----
# Optional secret to protect the /api/cron/follow-ups route (for Vercel Cron /
# external schedulers). The in-process scheduler needs no cron at all.
CRON_SECRET=""

# ---- Lead research (grounded personalization) ----
# Tavily web search (https://tavily.com, free tier). Optional — research falls
# back to the company website only. Never touches LinkedIn.
TAVILY_API_KEY=""

# ---- Email sending providers ----
# EMAIL_PROVIDER: "mock" (default) | "gmail_smtp" | "resend" | "smartlead"
EMAIL_PROVIDER="mock"

# Gmail App Password (SMTP send + IMAP reply sync). Requires 2-Step Verification
# and an App Password from https://myaccount.google.com/apppasswords
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
IMAP_HOST="imap.gmail.com"
IMAP_PORT="993"
MAIL_FROM_NAME="Stanford Consulting"

# Resend — transactional HTTPS email (works on serverless, no personal inbox).
# Key: https://resend.com/api-keys  ·  RESEND_FROM must be a verified sender.
RESEND_API_KEY=""
RESEND_FROM=""

SMARTLEAD_API_KEY=""
