// SC Sourcing Engine — Prisma schema
//
// NOTE ON DATABASE PROVIDER
// -------------------------
// Production uses PostgreSQL (Neon via Vercel). DATABASE_URL is the pooled
// connection; DIRECT_URL is the unpooled endpoint used for `prisma db push`.
// For local development, point both at any Postgres (a free Neon project
// works great — same URL for both is fine).
//
// Storage conventions (kept portable / simple to query):
//   - "enum-like" fields are stored as String with allowed values documented.
//   - list fields (industries, functions) are stored as comma-separated String.
//   - JSON blobs (scoreBreakdown, warnings) are stored as JSON-encoded String.
// Helpers in src/lib/serialization.ts encode/decode these consistently.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Unpooled endpoint for schema pushes/migrations (Neon: remove "-pooler").
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Users & roles
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  // Role: "ADMIN" | "PD" | "REVIEWER"
  role      String   @default("PD")
  // scrypt hash ("salt:hex"). Null only for legacy rows; login requires it.
  passwordHash String?
  createdAt DateTime @default(now())

  pdProfile     PDProfile?
  assignedLeads Lead[]         @relation("AssignedPD")
  reviews       OutreachDraft[] @relation("Reviewer")
  interactions  Interaction[]
  sessions      Session[]
  invitesSent   Invite[]       @relation("InvitedBy")
}

// Server-side sessions: the cookie stores an opaque token, validated in the DB.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Team invites: admin creates one per email+role; the link /join/<token>
// lets the invitee set their name + password.
model Invite {
  id          String    @id @default(cuid())
  email       String
  // "ADMIN" | "PD" | "REVIEWER"
  role        String    @default("PD")
  token       String    @unique
  invitedById String?
  invitedBy   User?     @relation("InvitedBy", fields: [invitedById], references: [id])
  acceptedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
}

model PDProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Comma-separated lists (e.g. "fintech,healthtech")
  industries String @default("")
  // Functional interests: strategy,gtm,product,operations,technical,ai,market_research
  functions  String @default("")
  // "high" | "medium" | "low" | "unavailable"
  availability    String @default("medium")
  activeLeadCount Int    @default(0)
  notes           String @default("")
}

// ---------------------------------------------------------------------------
// Leads & companies
// ---------------------------------------------------------------------------

model Lead {
  id           String  @id @default(cuid())
  firstName    String?
  lastName     String?
  fullName     String?
  email        String?
  personalEmail String?
  workEmail    String?
  linkedinUrl  String?
  title        String?
  // "founder" | "c_suite" | "vp" | "director" | "head" | "manager" | "ic" | "other"
  seniority    String?
  companyName  String?
  companyWebsite String?
  industry     String?
  location     String?
  // "1-10" | "11-50" | "51-200" | "201-500" | "501-1000" | "1001-5000" | "5000+"
  companySize  String?

  // "csv_alumni" | "csv_generic" | "apollo" | "clay" | "manual"
  source       String  @default("manual")

  isStanfordAlum    Boolean @default(false)
  isSCAlum          Boolean @default(false)
  isFormerClient    Boolean @default(false)
  // "alumni" | "intro_available" | "mutual" | "prior_client" | "none"
  warmConnectionType  String  @default("none")
  warmConnectionNotes String  @default("")
  verifiedEmail       Boolean @default(false)

  score             Int     @default(0)
  // JSON-encoded ScoreBreakdown (see src/lib/types.ts)
  scoreBreakdownJson String @default("{}")

  // Grounded research (JSON ResearchResult: summary, signals, hook, sources).
  // Populated by the Research action; fed into outreach generation.
  researchJson      String   @default("")
  researchedAt      DateTime?
  // "High" | "Medium" | "Low"
  priority          String  @default("Low")

  // Lifecycle status — see STATUSES in src/lib/types.ts
  // sourced | enriched | drafted | needs_review | approved | ready_to_send |
  // sent | follow_up_1_sent | follow_up_2_sent | replied | booked | assigned |
  // not_interested | no_response
  status       String  @default("sourced")

  assignedPDId String?
  assignedPD   User?   @relation("AssignedPD", fields: [assignedPDId], references: [id])

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drafts       OutreachDraft[]
  interactions Interaction[]

  @@index([status])
  @@index([source])
  @@index([assignedPDId])
}

model Company {
  id          String  @id @default(cuid())
  name        String
  website     String?
  industry    String?
  size        String?
  location    String?
  description String?
  // e.g. "Series B raised 2024-09" — free text signal
  fundingSignal String?
  hiringSignal  String?
  notes         String?

  leads Lead[]
}

// ---------------------------------------------------------------------------
// Outreach
// ---------------------------------------------------------------------------

model OutreachDraft {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // "stanford_alum" | "founder_startup" | "corporate_exec" | "prior_client_warm" | "cold_high_fit"
  type    String
  subject String  @default("")
  body    String  @default("")
  followUp1 String @default("")
  followUp2 String @default("")
  personalizationNote String @default("")
  confidenceScore     Int    @default(0)
  // JSON-encoded string[] of warnings
  warningsJson        String @default("[]")

  // "needs_review" | "approved" | "rejected" | "ready_to_send" | "sent"
  status     String  @default("needs_review")
  reviewerId String?
  reviewer   User?   @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Interaction {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // "note" | "status_change" | "email_sent" | "reply" | "call_booked" | "assignment"
  type      String
  notes     String   @default("")
  date      DateTime @default(now())
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])

  @@index([leadId])
}

// ---------------------------------------------------------------------------
// Import jobs
// ---------------------------------------------------------------------------

model ImportJob {
  id             String   @id @default(cuid())
  // "alumni" | "generic"
  type           String
  filename       String
  rowCount       Int      @default(0)
  importedCount  Int      @default(0)
  duplicateCount Int      @default(0)
  errorCount     Int      @default(0)
  // "pending" | "completed" | "failed"
  status         String   @default("completed")
  createdAt      DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Configuration: scoring rules, email templates, org settings
// ---------------------------------------------------------------------------

model ScoringRule {
  id      String  @id @default(cuid())
  key     String  @unique
  label   String
  weight  Int     @default(0)
  enabled Boolean @default(true)
}

model EmailTemplate {
  id              String  @id @default(cuid())
  name            String
  // matches OutreachDraft.type
  type            String
  subjectTemplate String  @default("")
  bodyTemplate    String  @default("")
  followUp1Template String @default("")
  followUp2Template String @default("")
  enabled         Boolean @default(true)
}

// Key/value organisation settings (singleton-ish).
model Setting {
  id    String @id @default(cuid())
  key   String @unique
  // JSON-encoded value
  value String @default("")
}
